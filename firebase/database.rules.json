{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "topics": {
      ".read": "auth != null",
      "$tid": {
        ".write": "auth != null && ((auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true) || (!data.exists() && newData.child('authorUid').val() == auth.uid) || (data.exists() && data.child('authorUid').val() == auth.uid))",
        "authorUid": {
          ".validate": "(!data.exists() && newData.val() == auth.uid) || newData.val() == data.val()"
        },
        "pinned": {
          ".validate": "newData.val() == data.val() || (!data.exists() && newData.val() == false) || (auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true)"
        },
        "likes": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "replyCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "replies": {
      ".read": "auth != null",
      "$tid": {
        ".write": "auth != null && ((auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true) || (!newData.exists() && root.child('topics').child($tid).child('authorUid').val() == auth.uid && !newData.parent().parent().child('topics').child($tid).exists()))",
        "$rid": {
          ".write": "auth != null && ((auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true) || (!data.exists() && newData.child('authorUid').val() == auth.uid && root.child('topics').child($tid).exists()) || (data.exists() && data.child('authorUid').val() == auth.uid))",
          "authorUid": {
            ".validate": "(!data.exists() && newData.val() == auth.uid) || newData.val() == data.val()"
          },
          "likes": {
            ".write": "auth != null",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || (auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true))"
      }
    },
    "members": {
      ".read": "auth != null && auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true",
      ".write": "auth != null && auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && newData.exists() && (data.exists() ? newData.child('level').val() == data.child('level').val() && newData.child('paidUntil').val() == data.child('paidUntil').val() : newData.child('level').val() == 'sentinela')",
        "level": {
          ".validate": "newData.isString() && newData.val().matches(/^(sentinela|operador|comando)$/)"
        }
      }
    },
    "cursos": {
      ".read": "auth != null && (auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true)",
      "$slug": {
        ".read": "auth != null && ((auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true) || ((root.child('members').child(auth.uid).child('level').val() == 'operador' || root.child('members').child(auth.uid).child('level').val() == 'comando') && (!root.child('members').child(auth.uid).child('paidUntil').exists() || root.child('members').child(auth.uid).child('paidUntil').val() > now)))",
        ".write": "(auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true)"
      }
    },
    "chat": {
      "$room": {
        ".read": "auth != null && $room.matches(/^(geral|equipamentos|comunicacao|ameacas|offtopic)$/)",
        ".indexOn": [
          "ts"
        ],
        "$mid": {
          ".write": "auth != null && $room.matches(/^(geral|equipamentos|comunicacao|ameacas|offtopic)$/) && ((!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid && newData.parent().parent().parent().child('chatLast').child(auth.uid).val() == now) || (data.exists() && !newData.exists() && (data.child('uid').val() == auth.uid || data.child('ts').val() < now - 300000 || (auth.token.email == 'preppersbr1@gmail.com' && auth.token.email_verified == true))))",
          ".validate": "newData.hasChildren(['uid','name','text','ts'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
          },
          "ts": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chatPm": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".indexOn": [
          "ts"
        ],
        "$mid": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('from').val() == auth.uid && ($uid == auth.uid || $uid == newData.child('to').val()) && newData.child('to').val() != auth.uid && newData.parent().parent().child(auth.uid).child($mid).exists() && newData.parent().parent().child(newData.child('to').val()).child($mid).exists() && root.child('users').child(newData.child('to').val()).exists() && newData.parent().parent().parent().child('chatLast').child(auth.uid).val() == now) || (data.exists() && !newData.exists() && $uid == auth.uid))",
          ".validate": "newData.hasChildren(['from','fromName','to','toName','text','ts'])",
          "from": {
            ".validate": "newData.isString()"
          },
          "to": {
            ".validate": "newData.isString()"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "toName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
          },
          "ts": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chatLast": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.val() == now && (!data.exists() || now - data.val() >= 2000)"
      }
    },
    "chatOnline": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && $room.matches(/^(geral|equipamentos|comunicacao|ameacas|offtopic)$/)",
          ".validate": "!newData.exists() || (newData.hasChildren(['name','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 24)"
        }
      }
    }
  }
}
